---
export const prerender = true;

import Layout from "@/layouts/LayoutBase.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import "@/styles/prose.css";

const sampleIds = [
    7493860, // regular with anchor
    6359001, // timestamp anchors
    1076482, // multi-tweet list
    20136805, // link-only tweet
    97881177, // quote-style retweet
    4896575, // via pattern with symbol
];

const posts = await getSortedPosts();
const postById = new Map(posts.map((post) => [post.data.id, post]));

const samples = await Promise.all(
    sampleIds
        .map((id) => postById.get(id))
        .filter(Boolean)
        .map(async (post) => ({
            post,
            Content: (await post.render()).Content,
        }))
);

const variants = [
    { id: "current", label: "Current" },
    { id: "tweet-canonical", label: "Canonical" },
    { id: "tweet-compact", label: "Compact" },
];

const getTitle = (post) =>
    post.data.title ? post.data.title : `Пост ${post.data.id}`;
---

<Layout title="Tweet Format Playground" description="Tweet format preview">
    <div class="playground">
        <header class="page-header">
            <h1>Tweet Format Playground</h1>
            <p>
                Sample tweet-like posts rendered in multiple layout variants for
                comparison.
            </p>
        </header>

        {samples.map(({ post, Content }) => (
            <section class="sample">
                <h2 class="sample-title">
                    {getTitle(post)} <span>#{post.data.id}</span>
                </h2>
                <div class="variant-grid">
                    {variants.map((variant) => (
                        <article
                            class:list={["variant", variant.id, "prose", post.data.form]}
                        >
                            <h3>{variant.label}</h3>
                            {post.data.form === "link" && post.data.linkurl ? (
                                <p class="tweet-link">
                                    →{" "}
                                    <a
                                        href={post.data.linkurl}
                                        target="_blank"
                                        rel="noopener noreferrer nofollow"
                                    >
                                        {post.data.title}
                                    </a>
                                </p>
                            ) : (
                                <p class="tweet-link">{getTitle(post)}</p>
                            )}
                            {Content && <Content />}
                        </article>
                    ))}
                </div>
            </section>
        ))}
    </div>
</Layout>

<style>
    .playground {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-3xl);
        margin: 0 auto;
        padding: var(--spacing-2xl) 0;
        max-width: 1200px;
    }

    .page-header h1 {
        margin-bottom: var(--spacing-sm);
    }

    .sample {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-lg);
        border-top: 1px solid var(--color-grey-200);
        padding-top: var(--spacing-2xl);
    }

    .sample-title {
        font-size: var(--font-size-lg);
        margin: 0;
    }

    .sample-title span {
        color: var(--color-grey-500);
        font-size: var(--font-size-xs);
        margin-left: var(--spacing-sm);
    }

    .variant-grid {
        display: grid;
        gap: var(--spacing-xl);
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    }

    .variant {
        border: 1px solid var(--color-grey-200);
        border-radius: 12px;
        padding: var(--spacing-lg);
        background: white;
        min-height: 220px;
    }

    .variant h3 {
        margin-top: 0;
        font-size: var(--font-size-sm);
        color: var(--color-grey-500);
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .tweet-link {
        font-size: var(--font-size-sm);
        color: var(--color-grey-500);
    }

    .tweet-canonical a[href*="twitter.com"],
    .tweet-canonical a[href*="t.co"] {
        background-color: transparent;
        color: var(--color-grey-500);
        font-size: var(--font-size-xs);
    }

    .tweet-canonical p {
        margin-bottom: var(--spacing-sm);
    }

    .tweet-compact {
        font-size: var(--font-size-xs);
    }

    .tweet-compact p {
        margin: var(--spacing-xs) 0;
    }

    @media (width <= 600px) {
        .variant {
            padding: var(--spacing-md);
        }
    }
</style>
